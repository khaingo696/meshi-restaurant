---
/* Jediná sekce bez jakékoli dekorace. Plochu nedržuje kresba, ale materiál:
   washi vlákno a tonální přechod. Ozdoba je jen sumi vlnka pod nadpisem. */
import Rule from "./Rule.astro";
---

<section class="section bg-canvas wash paper" id="poukaz">
  <div class="wrap">
    <div class="voucher-grid">
      <div>
        <span class="eyebrow" data-rv="fade-right" data-i18n="gift.eyebrow">Darujte zážitek</span>
        <h2 data-rv="fade-up" style="margin-top:.7rem" data-i18n="gift.title">Dárkový poukaz do MESHi</h2>
        <Rule style="margin-top:1rem" />
        <p class="lead" data-rv="fade-up" style="margin-top:.8rem" data-i18n="gift.body">
          Chcete udělat radost svým blízkým a dopřát jim kousek ráje na talíři? Pořiďte jim dárkový
          poukaz do MESHi. Vyplňte hodnotu a kontakt — ozveme se obratem s platebními údaji.
        </p>

        <figure class="gift" data-rv="fade-up">
          <img src="/assets/voucher.webp" width="1600" height="800" alt="Dárkový poukaz MESHi: jméno, hodnota a platnost" data-i18n-alt="gift.alt" loading="lazy" />
        </figure>
      </div>

      <div class="card" style="padding:clamp(1.4rem,3vw,2.2rem)" data-rv="fade-up">
        <h3 data-i18n="gift.formTitle">Darujte poukaz</h3>
        <p class="small" style="color:var(--muted); margin-top:.3rem" data-i18n="gift.formSub">Vyplňte hodnotu a kontakt. Ozveme se s platebními údaji a možnostmi předání.</p>

        <form class="stack" id="vForm" style="margin-top:1.2rem" novalidate>
          <div class="field">
            <label data-i18n="gift.value">Požadovaná hodnota poukazu</label>
            <div class="vals">
              <label><input type="radio" name="val" value="500" /><span>500 Kč</span></label>
              <label><input type="radio" name="val" value="1000" checked /><span>1 000 Kč</span></label>
              <label><input type="radio" name="val" value="2000" /><span>2 000 Kč</span></label>
            </div>
          </div>
          <div class="field"><label for="v-phone" data-i18n="gift.phone">Vaše telefonní číslo *</label><input id="v-phone" type="tel" placeholder="+420 777 000 000" required /></div>
          <div class="field"><label for="v-mail" data-i18n="gift.mail">Váš e-mail *</label><input id="v-mail" type="email" placeholder="vas@email.cz" data-i18n-placeholder="gift.mailPh" required /></div>
          <div class="field">
            <label data-i18n="gift.deliver">Jak poukaz doručit</label>
            <div class="radio-rows">
              <label><input type="radio" name="doruceni" checked /><span data-i18n="gift.mailPdf">Pošlete mi poukaz e-mailem v PDF k tisku</span></label>
              <label><input type="radio" name="doruceni" /><span data-i18n="gift.pickup">Vyzvednu si ho osobně v dárkovém balení</span></label>
            </div>
          </div>
          <div class="consent">
            <input id="v-gdpr" type="checkbox" required />
            <label for="v-gdpr" data-i18n="gift.gdpr">Souhlasím se zpracováním osobních údajů pro vyřízení objednávky.</label>
          </div>
          <button class="btn btn-primary" type="submit" style="width:100%; justify-content:center; padding:.85rem 1.4rem" data-i18n="gift.submit">Objednat dárkový poukaz</button>
          <p class="ok-box" id="vOk" role="status" data-i18n="gift.ok">Děkujeme! Ozveme se vám do hodiny s instrukcemi k platbě a vyzvednutí.</p>
        </form>
      </div>
    </div>
  </div>
</section>
