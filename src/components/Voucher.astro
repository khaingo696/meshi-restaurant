---
/*
  Dárkový poukaz — jediná světlá plocha webu.

  Mění vzduch mezi řadou tmavých sekcí. Oba okraje se rozplývají přesně do
  barvy sekce nad a pod, takže na přechodu nevzniká linka (viz .gift::before
  a ::after v global.css).

  Mockup tady místo formuláře kreslí jen tlačítko. Objednávka poukazu je ale
  funkce, kterou web má, takže v pravém sloupci zůstal formulář — jen ve
  světlé variantě panelu, aby na prosvětlené ploše nedělal tmavou díru.
*/
---

<section class="gift" id="poukaz">
  <div class="secbg" aria-hidden="true"><img src="/assets/bg/gift.webp" alt="" /></div>

  <div class="wrap giftIn">
    <div class="giftCopy">
      <span class="eyebrow eyebrow--onLight" data-i18n="gift.eyebrow">Darujte zážitek</span>
      <h2 class="h2 h2--onLight">
        <span class="ml"><span class="ml__i" data-i18n="gift.title1">Dárkový poukaz</span></span>
        <span class="ml"><span class="ml__i"><em data-i18n="gift.title2">do MESHi</em></span></span>
      </h2>
      <p class="lead lead--onLight" data-i18n-html="gift.body">
        Chcete udělat radost svým blízkým a dopřát jim kousek ráje na talíři? Vyplňte hodnotu a kontakt —
        ozveme se obratem s platebními údaji. Poukaz pošleme <strong>v PDF k tisku</strong>, nebo si ho
        vyzvednete osobně v dárkovém balení.
      </p>

      <figure class="giftShot">
        <img src="/assets/voucher.webp" width="1600" height="800"
             alt="Dárkový poukaz MESHi: jméno, hodnota a platnost" data-i18n-alt="gift.alt" loading="lazy" />
      </figure>
    </div>

    <form class="panel panel--light form" id="vForm" novalidate>
      <h3 data-i18n="gift.formTitle">Darujte poukaz</h3>

      <div class="field field--full">
        <span class="field__label" data-i18n="gift.value">Požadovaná hodnota poukazu</span>
        <div class="vals">
          <label><input type="radio" name="val" value="500" /><span>500 Kč</span></label>
          <label><input type="radio" name="val" value="1000" checked /><span>1 000 Kč</span></label>
          <label><input type="radio" name="val" value="2000" /><span>2 000 Kč</span></label>
        </div>
      </div>

      <label class="field field--full">
        <span class="field__label" data-i18n="gift.mail">Váš e-mail *</span>
        <input id="v-mail" name="email" type="email" placeholder="vas@email.cz" data-i18n-placeholder="gift.mailPh" autocomplete="email" required />
      </label>
      <label class="field field--full">
        <span class="field__label" data-i18n="gift.phone">Vaše telefonní číslo *</span>
        <input id="v-phone" name="phone" type="tel" placeholder="+420 777 000 000" autocomplete="tel" required />
      </label>

      <div class="field field--full">
        <span class="field__label" data-i18n="gift.deliver">Jak poukaz doručit</span>
        <div class="radio-rows">
          <label><input type="radio" name="doruceni" checked /><span data-i18n="gift.mailPdf">Pošlete mi poukaz e-mailem v PDF k tisku</span></label>
          <label><input type="radio" name="doruceni" /><span data-i18n="gift.pickup">Vyzvednu si ho osobně v dárkovém balení</span></label>
        </div>
      </div>

      <div class="consent">
        <input id="v-gdpr" name="gdpr" type="checkbox" required />
        <label for="v-gdpr" data-i18n="gift.gdpr">Souhlasím se zpracováním osobních údajů pro vyřízení objednávky.</label>
      </div>

      <button class="btn btn--ink btn--lg" type="submit">
        <span data-i18n="gift.submit">Objednat poukaz</span> <span class="btn__arrow" aria-hidden="true">→</span>
      </button>

      <p class="ok-box" id="vOk" role="status" data-i18n="gift.ok">Děkujeme! Ozveme se vám do hodiny s instrukcemi k platbě a vyzvednutí.</p>
    </form>
  </div>
</section>
