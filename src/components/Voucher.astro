---
import { Icon } from "astro-icon/components";
import { site } from "../data/site";
import { t, type Lang } from "../data/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t[lang];
---

{/*
  Dárkový poukaz. V zadání je jako položka navigace vedoucí na Hatsu.cz,
  proto sekce jen představí nabídku a pošle hosta na jejich platformu.
*/}
<section class="border-y border-line">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-10 gap-y-6 py-12 md:py-16">
    <div class="min-w-0 flex-1 basis-[32rem]">
      <h2 data-split class="font-display text-[clamp(1.8rem,3.4vw,2.6rem)] leading-none text-fg">
        {copy.voucher.heading}
      </h2>
      <p class="mt-4 max-w-[62ch] text-[0.98rem] leading-[1.75] text-fg-muted">{copy.voucher.body}</p>
    </div>

    <a
      href={site.giftVoucherUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-magnetic
      class="inline-flex items-center gap-2.5 rounded-full border border-accent-deep px-7 py-3.5 text-[0.76rem] tracking-[0.14em] whitespace-nowrap uppercase text-accent-deep transition-colors duration-300 hover:btn-primary hover:text-btn-fg"
    >
      {copy.voucher.cta}
      <Icon name="ph:arrow-up-right" class="size-4" />
    </a>
  </div>
</section>
