---
/*
  Dárkový poukaz — vitrína v tónu tuše.

  Podmalba je světlejší list Kōrin (zlato + meruňka), stejná škola tuše
  jako ostatní plochy. Poukaz zůstává předmětem na skle.
*/
import Blend from "./Blend.astro";
---

<section class="gift" id="poukaz" data-tone="lift">
  <div class="secbg secbg--lift" aria-hidden="true"><img src="/assets/bg/paper-plum.webp" alt="" /></div>

  <div class="wrap giftIn">
    <div class="giftCopy">
      <span class="eyebrow eyebrow--gold" data-i18n="gift.eyebrow">Darujte zážitek</span>
      <h2 class="h2">
        <span class="ml"><span class="ml__i" data-i18n="gift.title1">Dárkový poukaz</span></span>
        <span class="ml"><span class="ml__i"><em data-i18n="gift.title2">do MESHi</em></span></span>
      </h2>
      <p class="lead" data-i18n-html="gift.body">
        Chcete udělat radost svým blízkým a dopřát jim kousek ráje na talíři? Vyplňte hodnotu a kontakt.
        <span class="gift-lead-more"> Ozveme se obratem s platebními údaji. Poukaz pošleme <strong>v PDF k tisku</strong>, nebo si ho
        vyzvednete osobně v dárkovém balení.</span>
      </p>

      <figure class="giftShot">
        <img src="/assets/voucher.webp" width="1600" height="800"
             alt="Dárkový poukaz MESHi: jméno, hodnota a platnost" data-i18n-alt="gift.alt" loading="lazy" />
      </figure>

    </div>

    <!-- Na telefonu je formulář sám poukazem (CSS, sekce 18): hlava
         s logem a hodnotou, trhací linka s výseky, pod ní ústřižek.
         Zavřený ukazuje jen hodnotu, dvě řádky o doručení a tlačítko;
         ostatní pole se probudí do ústřižku (app.js §6). Hlava, linka
         a řádky o doručení jsou na desktopu skryté. -->
    <form class="panel form" id="vForm" tabindex="-1" novalidate>
      <div class="vHead" aria-hidden="true">
        <img src="/assets/meshi_logo_hero.png" width="593" height="421" alt="" loading="lazy" />
        <span class="vSerial"></span>
      </div>

      <div class="field field--full field--val">
        <span class="field__label" data-i18n="gift.value">Požadovaná hodnota poukazu</span>
        <div class="vals">
          <label><input type="radio" name="val" value="500" /><span><b>500</b> <small>Kč</small></span></label>
          <label><input type="radio" name="val" value="1000" checked /><span><b>1 000</b> <small>Kč</small></span></label>
          <label><input type="radio" name="val" value="2000" /><span><b>2 000</b> <small>Kč</small></span></label>
        </div>
      </div>

      <div class="vTear" aria-hidden="true"></div>

      <ul class="giftMeta">
        <li data-i18n="gift.metaPdf">PDF k tisku do e-mailu</li>
        <li data-i18n="gift.metaBox">Nebo v dárkovém balení k vyzvednutí</li>
      </ul>

      <div class="actRow" id="giftActs">
        <button class="btn btn--act btn--lg" type="button" id="giftOpen" aria-expanded="false" aria-controls="vForm" data-i18n="gift.submit">Objednat poukaz</button>
      </div>

      <label class="field field--full">
        <span class="field__label" data-i18n="gift.mail">Váš e-mail *</span>
        <input id="v-mail" name="email" type="email" placeholder="vas@email.cz" data-i18n-placeholder="gift.mailPh" autocomplete="email" required />
      </label>
      <label class="field field--full">
        <span class="field__label" data-i18n="gift.phone">Vaše telefonní číslo *</span>
        <input id="v-phone" name="phone" type="tel" placeholder="+420 777 000 000" autocomplete="tel" required />
      </label>

      <div class="field field--full">
        <span class="field__label" data-i18n="gift.deliver">Jak poukaz doručit</span>
        <div class="radio-rows">
          <label><input type="radio" name="doruceni" checked /><span data-i18n="gift.mailPdf">Pošlete mi poukaz e-mailem v PDF k tisku</span></label>
          <label><input type="radio" name="doruceni" /><span data-i18n="gift.pickup">Vyzvednu si ho osobně v dárkovém balení</span></label>
        </div>
      </div>

      <div class="consent">
        <input id="v-gdpr" name="gdpr" type="checkbox" required />
        <label for="v-gdpr" data-i18n="gift.gdpr">Souhlasím se zpracováním osobních údajů pro vyřízení objednávky.</label>
      </div>

      <button class="btn btn--act btn--lg" type="submit">
        <span data-i18n="gift.submit">Objednat poukaz</span>
        <span class="btn__arrow" aria-hidden="true"><svg><use href="#ic-arrow"/></svg></span>
      </button>

      <p class="ok-box" id="vOk" role="status" data-i18n="gift.ok">Děkujeme! Ozveme se vám do hodiny s instrukcemi k platbě a vyzvednutí.</p>
    </form>
  </div>
  <Blend to="lift" />
</section>
