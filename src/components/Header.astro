---
/*
  Lišta.

  V liště je tlačítko Menu vlevo, logo na střed a vpravo přepínač jazyka
  s rezervací. Celá navigace žije v panelu <Sheet>, a to na všech šířkách —
  ne jen na telefonu. Odkazy, telefon i online objednávka jsou tam.

  Rezervace je jediná akce, která zůstala v liště, a je tu schválně:
  v panelu je vidět až po otevření, kdežto tady visí nad celou stránkou.
  V <Sheet> proto stejné tlačítko není — jedna akce, jedno místo.

  Přepínač jazyka je vedle ní jen na širokém displeji: CZ/EN je stav,
  ne cíl. Pod 810 px odchází do panelu.
*/
---

<header class="nav" id="nav">
  <div class="nav__in">
    <!-- Zavřeno = tři linky, otevřeno = kříž (CSS) a popisek „Zavřít“ (app.js). -->
    <button class="nav__burger" id="burger" type="button"
            aria-label="Otevřít nabídku" data-i18n-aria="nav.openMenu"
            aria-expanded="false" aria-controls="sheet">
      <span class="nav__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="nav__burgerLabel" data-i18n="nav.menu">Menu</span>
    </button>

    <a class="nav__logo" href="#top" aria-label="MESHi — domů" data-i18n-aria="nav.brandHome">
      <img src="/assets/meshi_logo_hero.png?v=gold" width="593" height="421" alt="MESHi" />
    </a>

    <div class="nav__right">
      <div class="lang" role="group" aria-label="Jazyk" data-i18n-aria="nav.lang">
        <button type="button" class="on" data-lang="cs" aria-pressed="true">CZ</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <a class="btn btn--gold" href="#rezervace" data-i18n="nav.reserve">Rezervace</a>
    </div>
  </div>
</header>
