<section class="hero" id="hero">
  <div class="hero-media" id="heroMedia">
    <video autoplay muted loop playsinline poster="/assets/hero-poster.webp" aria-hidden="true">
      <source src="/assets/background_video.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero-veil v1" aria-hidden="true"></div>
  <div class="hero-veil v2" aria-hidden="true"></div>
  <div class="hero-veil v3" aria-hidden="true"></div>

  <div class="hero-art">
    <div class="hero-float" data-hero="7">
      <p class="hero-note" id="openState">
        <i class="dot"></i><span>Otevřeno – zavíráme ve 23:00</span>
      </p>
      <a class="hero-rating" id="gRatingLink" target="_blank" rel="noopener noreferrer"
         href="https://www.google.com/maps/search/?api=1&amp;query=Meshi%20restaurant%2C%20n%C3%A1m.%20Republiky%20107%2F14%2C%20301%2000%20Plze%C5%88">
        <span class="score" id="gRatingScore" aria-hidden="true">4,9</span>
        <span class="rt">
          <span class="rt-top">
            <span class="stars" aria-hidden="true">
              <svg><use href="#ic-star"/></svg><svg><use href="#ic-star"/></svg><svg><use href="#ic-star"/></svg><svg><use href="#ic-star"/></svg><svg><use href="#ic-star"/></svg>
            </span>
            <b>Google</b>
          </span>
          <span class="rt-sub"><span id="gRatingCountLabel">252 recenzí</span><span class="addr"> • nám. Republiky 107/14, 301 00 Plzeň 3-Vnitřní Město</span></span>
        </span>
        <span class="go" aria-hidden="true"><svg><use href="#ic-arrow"/></svg></span>
      </a>
    </div>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="hero-logo" data-hero="logo">
        <img src="/assets/meshi_logo_hero.png?v=gold" alt="MESHi — Traditional Asian Cuisine &amp; Premium Sushi" />
      </span>

      <h1>
        <span class="mask-line"><span data-hero="2">Taste <i class="dv" aria-hidden="true"></i> Feel <i class="dv" aria-hidden="true"></i> Connect</span></span>
        <span class="mask-line"><span class="ital" data-hero="2">A Taste of Home. On Your Plate.</span></span>
      </h1>

      <div class="hero-cta" data-hero="4">
        <a class="btn btn-primary" href="#rezervace"><svg><use href="#ic-table"/></svg><span data-i18n="nav.reserveTable">Rezervovat stůl</span></a>
        <a class="btn btn-glass" href="#signatures"><span data-i18n="hero.explore">Prozkoumat menu</span><svg class="dn"><use href="#ic-arrow"/></svg></a>
      </div>
    </div>
  </div>

</section>
