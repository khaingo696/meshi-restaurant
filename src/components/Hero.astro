---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/logo-meshi.png";
import Leaves from "./Leaves.astro";
import FallingLeaves from "./FallingLeaves.astro";
import { site, mapsUrl } from "../data/site";
import { sections, t, type Lang } from "../data/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t[lang];
---

{/*
  Domů. Logo, podtitul, slogan, dvě akce. Nic víc, aby první obrazovka
  nezahltila. Podkladem je papír z prostírání a javorové listy z něj.

  Slogan se skládá po písmenech: každé se doostří z rozmazání. Působí to,
  jako by nápis vystupoval z papíru, ne že tam prostě je.
*/}
<section
  id={sections.home}
  data-hero
  class="pointer-events-none relative z-[32] flex min-h-[100dvh] flex-col overflow-hidden pt-28 pb-20"
>
  <Leaves />
  <FallingLeaves />

  <div class="wrap pointer-events-auto relative z-10 my-auto flex flex-col items-center text-center">
    <Image
      data-reveal
      src={logo}
      alt="Meshi"
      widths={[280, 460, 620]}
      sizes="(min-width: 768px) 21rem, 15.5rem"
      loading="eager"
      fetchpriority="high"
      class="w-[15.5rem] md:w-[21rem]"
    />

    <p
      data-reveal
      data-reveal-delay="0.08"
      class="mt-4 text-[0.9rem] tracking-[0.24em] uppercase text-fg-muted md:mt-5 md:text-[1.05rem]"
    >
      {copy.home.tagline}
    </p>

    <h1 class="slogan relative mt-10 inline-block md:mt-11">
      <span data-typewriter>{copy.home.slogan}</span>
      <span data-caret aria-hidden="true"></span>
    </h1>

    <div
      data-reveal
      data-reveal-delay="0.2"
      class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-4 md:mt-9"
    >
      <a
        href={`#${sections.reserve}`}
        data-magnetic
        class="group inline-flex items-center gap-3 rounded-full btn-primary hover:btn-primary-hover px-9 py-4 text-[0.78rem] tracking-[0.14em] whitespace-nowrap uppercase text-btn-fg transition-colors duration-300 active:scale-[0.98]"
      >
        {copy.home.primary}
        <Icon
          name="ph:arrow-right"
          class="size-4 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
      <a
        href={`#${sections.menu}`}
        class="group inline-flex items-center gap-2.5 rounded-full border border-line-strong px-8 py-4 text-[0.78rem] tracking-[0.14em] whitespace-nowrap uppercase text-fg transition-colors duration-300 hover:border-accent hover:text-accent-deep"
      >
        {copy.home.secondary}
        <Icon
          name="ph:arrow-up-right"
          class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </div>

</section>

<style>
  /*
    Slogan nese celou první obrazovku, proto dostane vlastní sazbu:
    o něco těžší řez než zbytek nadpisů a sevřenější prostrkání, ať to není
    jen zvětšený běžný nadpis.
  */
  /* Kurzor psacího stroje. Stojí u levého okraje a GSAP ho posouvá za text. */
  [data-caret] {
    position: absolute;
    bottom: 0.14em;
    left: 0;
    display: block;
    width: 0.055em;
    height: 0.74em;
    background: var(--accent-deep);
    animation: caret-blink 1.05s steps(1, end) infinite;
  }

  @keyframes caret-blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-caret] {
      display: none;
    }
  }

  .slogan {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.6vw, 2.9rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
</style>
