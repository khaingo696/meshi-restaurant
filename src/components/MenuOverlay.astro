---
/*
  Překryv s jídelním lístkem — otevírá ho tlačítko v sekci Signatures.

  Plocha pod hlavičkou je krémová, ne tmavá. Fotky jídel jsou skoro všechny
  focené na světlém stole, takže na tmavé by každá svítila jako samostatný
  ostrov; na krémové splynou do jedné tištěné strany. Hlavička je naopak
  tmavá, aby překryv navazoval na zbytek webu.

  Kategorie se vykreslí všechny rovnou do HTML a přepínají se atributem
  hidden, takže přechod mezi nimi nic nedotahuje ze sítě. Fotky mají
  loading="lazy".

  Počet jídel visí na záložce jako data-n; text („14 jídel“) skládá app.js,
  protože se skloňuje a mění s jazykem.

  Adresa se při otevření mění na #menu/<slug> přes history.pushState, aby
  fungovalo zpět v prohlížeči i sdílení odkazu rovnou na kategorii.

  Ceny zatím nejsou (čeká se na finální lístek), proto se <b class="dish-price">
  vykreslí jen tehdy, když cena v src/data/menu.ts opravdu je.
*/
import { categories, formatPrice } from "../data/menu";
---

<div class="menu-ov" id="menuOv" role="dialog" aria-modal="true" aria-labelledby="menuOvTitle" hidden>
  <div class="menu-ov-scrim" data-close></div>

  <div class="menu-ov-panel" role="document">
    <header class="menu-ov-bar">
      <div class="menu-ov-id">
        <span class="menu-ov-kanji" aria-hidden="true">飯</span>
        <div>
          <h2 id="menuOvTitle" data-i18n="menu.title">Jídelní lístek</h2>
          <p id="menuOvNote"></p>
        </div>
      </div>

      <nav class="menu-ov-tabs" aria-label="Kategorie jídel" data-i18n-aria="menu.cats">
        {categories.map((cat) => (
          <button class="menu-ov-tab" type="button" data-go={cat.slug} data-n={cat.items.length}
                  aria-pressed="false" data-i18n={`cat.${cat.slug}`}>
            {cat.label}
          </button>
        ))}
      </nav>

      <button class="menu-ov-close" id="menuOvClose" type="button"
              aria-label="Zavřít jídelní lístek" data-i18n-aria="menu.close">
        <svg aria-hidden="true"><use href="#ic-close"/></svg>
      </button>
    </header>

    <div class="menu-ov-body" id="menuOvBody" data-lenis-prevent>
      {categories.map((cat) => (
        <section class="menu-pane" data-pane={cat.slug} hidden>
          <ul class="menu-grid">
            {cat.items.map((dish) => {
              const price = formatPrice(dish.price);
              const big = dish.img.replace(".webp", "@2x.webp");
              return (
                <li class="dish-card">
                  <button class="dish-zoom" type="button" data-full={big} data-name={dish.name}
                    aria-label={`Zvětšit fotku — ${dish.name}`}>
                    <img
                      src={dish.img}
                      srcset={`${dish.img} 800w, ${big} 1600w`}
                      sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 30vw"
                      alt={dish.name}
                      width="800"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                  <div class="dish-line">
                    <h3>{dish.name}</h3>
                    {price && <b class="dish-price">{price}</b>}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </div>
</div>
