---
/*
  Překryv s jídelním lístkem — otevírají ho karty v sekci Signatures.

  V hlavičce leží seigaiha (青海波, "vlny modrého moře") — dlaždici počítá
  scripts/build-patterns.py z geometrie, není kreslená od ruky. Dřív tu visel
  kreslený noren: závěs je vysoká věc a vmáčknutý do pásu 1100x90 px se vždycky
  četl jako řada dlaždic. Tradiční vzor je proti tomu přesná konstrukce ze
  soustředných kružnic, takže sedí i v pásu.

  Plocha pod závěsem je krémová, ne tmavá. Fotky jídel jsou skoro všechny
  focené na světlém stole, takže na tmavé by každá svítila jako samostatný
  ostrov; na krémové splynou do jedné tištěné strany.

  Kategorie se vykreslí všechny rovnou do HTML a přepínají se třídou, takže
  přechod mezi nimi nic nedotahuje ze sítě. Fotky mají loading="lazy".

  Adresa se při otevření mění na #menu/<slug> přes history.pushState, aby
  fungovalo zpět v prohlížeči i sdílení odkazu rovnou na kategorii.

  Ceny zatím nejsou (čeká se na finální lístek), proto se <b class="dish-price">
  vykreslí jen tehdy, když cena v src/data/menu.ts opravdu je.
*/
import { categories, formatPrice } from "../data/menu";

---

<div class="menu-ov" id="menuOv" role="dialog" aria-modal="true" aria-labelledby="menuOvTitle" hidden>
  <div class="menu-ov-scrim" data-close></div>

  <div class="menu-ov-panel" role="document">
    <header class="menu-ov-bar">
      <div class="menu-ov-id">
        <span class="menu-ov-mon" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="30.5" stroke="currentColor" stroke-width="1.2" />
            <path d="M16 42V22a2 2 0 0 1 3.5-1.3L26 28.5l6.5-7.8a2 2 0 0 1 3.5 1.3v20"
                  stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M42 20.5v21" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" />
          </svg>
        </span>
        <div>
          <h2 id="menuOvTitle" data-i18n="menu.title">Jídelní lístek</h2>
          <p id="menuOvNote"></p>
        </div>
      </div>

      <nav class="menu-ov-tabs" aria-label="Kategorie jídel" data-i18n-aria="menu.cats">
        {categories.map((cat) => (
          <button class="menu-ov-tab" type="button" data-go={cat.slug} aria-pressed="false" data-i18n={`cat.${cat.slug}`}>
            {cat.label}
          </button>
        ))}
      </nav>

      <button class="menu-ov-close" id="menuOvClose" type="button" aria-label="Zavřít jídelní lístek" data-i18n-aria="menu.close">
        <svg aria-hidden="true"><use href="#ic-close"/></svg>
      </button>

      <span class="menu-ov-rule" aria-hidden="true">
        <svg viewBox="0 0 240 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="1.1">
          <path d="M0 8c6-6 14-6 20 0s14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0" />
        </svg>
      </span>
    </header>

    <div class="menu-ov-body" id="menuOvBody" data-lenis-prevent>
      {categories.map((cat) => (
        <section class="menu-pane" data-pane={cat.slug} hidden>
          <ul class="menu-grid">
            {cat.items.map((dish) => {
              const price = formatPrice(dish.price);
              const big = dish.img.replace(".webp", "@2x.webp");
              return (
                <li class="dish-card">
                  <button class="dish-zoom" type="button" data-full={big} data-name={dish.name}
                    aria-label={`Zvětšit fotku — ${dish.name}`}>
                    <img
                      src={dish.img}
                      srcset={`${dish.img} 800w, ${big} 1600w`}
                      sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 30vw"
                      alt={dish.name}
                      width="800"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                  <div class="dish-line">
                    <h3>{dish.name}</h3>
                    {price && <b class="dish-price">{price}</b>}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </div>
</div>
