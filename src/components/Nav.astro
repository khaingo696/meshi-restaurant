---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { site } from "../data/site";
import { t, otherLangHref, sections, type Lang } from "../data/i18n";
import wordmark from "../assets/wordmark-meshi.png";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t[lang];
const base = lang === "cs" ? "/" : "/en/";

/*
  Položky přesně podle zadání majitelky. Dárkový poukaz vede ven na Hatsu.cz,
  proto má vlastní ikonu odchozího odkazu.
*/
const links = [
  { href: `${base}#${sections.home}`, label: copy.nav.home },
  { href: `#${sections.menu}`, label: copy.nav.menu },
  { href: `#${sections.gallery}`, label: copy.nav.gallery },
  { href: `#${sections.reserve}`, label: copy.nav.reserve },
  { href: site.giftVoucherUrl, label: copy.nav.voucher, external: true },
  { href: `#${sections.contact}`, label: copy.nav.contact },
];
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-30 h-[64px] border-b border-nav-line bg-nav-bg transition-shadow duration-500 md:h-[72px]"
>
  <div class="wrap flex h-full items-center justify-between gap-5">
    <a href={base} class="nav-brand shrink-0 transition-opacity hover:opacity-80">
      <Image
        src={wordmark}
        alt="Meshi"
        widths={[200, 320]}
        sizes="7.5rem"
        class="nav-wordmark h-[1.55rem] w-auto md:h-[1.75rem]"
      />
    </a>

    {/* Sedm položek se na jeden řádek vejde jen s úspornými rozestupy. */}
    <nav class="hidden items-center gap-5 xl:gap-7 lg:flex" aria-label={copy.nav.menu}>
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener noreferrer" : undefined}
            class="group relative inline-flex items-center gap-1 text-[0.8rem] font-medium tracking-[0.08em] whitespace-nowrap uppercase text-nav-fg transition-colors hover:text-nav-accent xl:text-[0.88rem]"
          >
            {l.label}
            {l.external && <Icon name="ph:arrow-up-right" class="size-3 opacity-60" />}
            <span class="absolute -bottom-1.5 left-0 h-px w-full origin-left scale-x-0 bg-nav-accent transition-transform duration-500 ease-[var(--ease-silk)] group-hover:scale-x-100" />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={otherLangHref(lang)}
        class="hidden px-2 py-1 text-[0.78rem] font-medium tracking-[0.12em] uppercase text-nav-muted transition-colors hover:text-nav-fg sm:block"
      >
        {copy.nav.langLabel}
      </a>

      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label={copy.nav.themeLabel}
        class="grid size-9 place-items-center rounded-full text-nav-muted transition-colors hover:text-nav-fg"
      >
        <Icon name="ph:sun" class="size-[17px] dark-hide" />
        <Icon name="ph:moon" class="size-[17px] light-hide" />
      </button>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={copy.nav.openMenu}
        class="grid size-9 place-items-center text-nav-fg lg:hidden"
      >
        <Icon name="ph:list" class="size-6" />
      </button>
    </div>
  </div>
</header>

<div
  id="nav-panel"
  data-nav-panel
  hidden
  class="fixed inset-0 z-40 flex flex-col bg-nav-bg px-6 pt-5 pb-10 text-nav-fg lg:hidden"
>
  <div class="flex items-center justify-between">
    <Image
      src={wordmark}
      alt="Meshi"
      widths={[200, 320]}
      sizes="8rem"
      class="nav-wordmark h-[1.65rem] w-auto"
    />
    <button
      type="button"
      data-nav-toggle
      aria-label={copy.nav.closeMenu}
      class="grid size-9 place-items-center text-nav-fg"
    >
      <Icon name="ph:x" class="size-6" />
    </button>
  </div>

  <nav class="mt-12 flex flex-col gap-5" aria-label={copy.nav.menu}>
    {
      links.map((l) => (
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noopener noreferrer" : undefined}
          class="inline-flex items-center gap-2 font-display text-3xl leading-none text-nav-fg"
        >
          {l.label}
          {l.external && <Icon name="ph:arrow-up-right" class="size-5 opacity-50" />}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto flex flex-col gap-4 pt-10">
    <hr class="h-px border-0 bg-nav-line" />
    <a href={`tel:${site.phone}`} class="text-nav-muted">{site.phoneDisplay}</a>
    <a href={otherLangHref(lang)} class="text-[0.8rem] tracking-[0.16em] uppercase text-nav-muted">
      {copy.nav.langLabel}
    </a>
  </div>
</div>

<style>
  /*
    Rozostření dělá z pásu sklo: pod ním prosvítá papír i letící listy.
    Po odscrollování jen přisedne stín, aby se lišta oddělila od obsahu.
  */
  [data-nav] {
    backdrop-filter: blur(20px) saturate(1.05);
    -webkit-backdrop-filter: blur(20px) saturate(1.05);
  }

  [data-nav].is-solid {
    box-shadow: 0 12px 34px -20px rgb(46 36 26 / 0.14);
  }

  /* Mobilní panel překrývá celou stránku, tam už průsvit nedává smysl. */
  [data-nav-panel] {
    background-color: var(--bg);
  }

  /*
    Wordmark z loga je tmavě hnědý. Ve světlém režimu sedí na papíru;
    v tmavém ho zvedneme do krémově zlaté, ať nezmizí na sumi pozadí.
  */
  :global(:root[data-theme="dark"]) .nav-wordmark {
    filter: brightness(0) invert(1) sepia(0.28) saturate(2.2) hue-rotate(5deg) brightness(0.95);
  }

  :global(:root[data-theme="dark"]) .dark-hide,
  :global(:root:not([data-theme="dark"])) .light-hide {
    display: none;
  }
</style>
