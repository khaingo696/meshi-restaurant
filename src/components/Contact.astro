---
import { Icon } from "astro-icon/components";
import { site, mapsUrl, OPENING } from "../data/site";
import { sections, t, type Lang } from "../data/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t[lang];

/*
  Kontakt podle zadání: adresa s odkazem do Map Google, otevírací doba,
  telefon, e-mail a ikony Instagramu a Facebooku.

  Zadání ukazuje jako referenci tři karty z webu Vian a majitelka o ně stojí,
  takže skladba je stejná: tři karty vedle sebe, kulatý zlatý terč sedící na
  horní hraně, prostřední karta zvýrazněná. Vian je má ostrohranné na černém
  dřevě; tady leží na papíru, mají rádius stránky a zlato je z loga.
*/
const order = [1, 2, 3, 4, 5, 6, 0] as const;
type Group = { days: number[]; open: string | null; close: string | null };

const groups: Group[] = [];
for (const day of order) {
  const h = OPENING[day];
  const last = groups.at(-1);
  if (last && last.open === (h?.open ?? null) && last.close === (h?.close ?? null)) {
    last.days.push(day);
  } else {
    groups.push({ days: [day], open: h?.open ?? null, close: h?.close ?? null });
  }
}

const groupLabel = (g: Group) =>
  g.days.length === 1
    ? copy.contact.days[g.days[0]!]
    : `${copy.contact.daysShort[g.days[0]!]} - ${copy.contact.daysShort[g.days.at(-1)!]}`;
---

<section id={sections.contact} class="relative overflow-hidden bg-bg-2 py-(--spacing-section)">
  <span
    data-parallax="9"
    aria-hidden="true"
    class="kana pointer-events-none absolute right-[-2vw] bottom-[4vh] text-[24vw] leading-none text-accent/[0.06] select-none lg:text-[14vw]"
  >
    店
  </span>

  <div class="wrap relative z-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-4">
      <h2 data-split class="display-lg text-fg">{copy.contact.heading}</h2>
      <p
        data-open-state
        data-label-open={copy.contact.openNow}
        data-label-closed={copy.contact.closedNow}
        hidden
        class="flex items-center gap-2.5 text-[0.82rem] tracking-[0.08em] text-fg-muted"
      >
        <span data-open-dot class="size-2 rounded-full bg-fg-muted"></span>
        <span data-open-label></span>
      </p>
    </div>

    <hr data-rule class="rule-gold mt-10" />

    {/*
      Tři karty. Terče přesahují nad horní hranu, proto má mřížka nahoře
      místo navíc a každá karta odsazený vnitřek.
    */}
    <div data-stagger class="mt-20 grid items-stretch gap-x-7 gap-y-20 md:mt-24 lg:grid-cols-3">
      {/* Adresa */}
      <article class="info-card">
        <span class="info-badge" aria-hidden="true">
          <Icon name="ph:map-pin" class="size-6" />
        </span>
        <h3 class="info-title">{copy.contact.addressTitle}</h3>
        <address class="mt-6 font-display text-[1.5rem] leading-[1.4] not-italic text-fg">
          {site.address.street}<br />
          {site.address.zip} {site.address.city}
        </address>

        {/* Odkaz místo vloženého iframu: ten by hned tahal cookies třetích stran. */}
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-auto inline-flex items-center gap-2 self-start border-b border-line-strong pt-8 pb-1 text-[0.74rem] tracking-[0.12em] uppercase text-fg transition-colors hover:border-accent hover:text-accent-deep"
        >
          {copy.contact.mapsCta}
          <Icon
            name="ph:arrow-up-right"
            class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </article>

      {/* Otevírací doba, zvýrazněná karta uprostřed */}
      <article class="info-card info-card--lead">
        <span class="info-badge" aria-hidden="true">
          <Icon name="ph:clock" class="size-6" />
        </span>
        <h3 class="info-title">{copy.contact.hoursTitle}</h3>
        <dl class="mt-6 w-full divide-y divide-line">
          {
            groups.map((g) => (
              <div class="flex items-baseline justify-between gap-5 py-3.5 first:pt-0 last:pb-0">
                <dt class="font-display text-[1.3rem] leading-none text-fg">{groupLabel(g)}</dt>
                <dd class="font-display text-[1.2rem] leading-none text-fg-muted tabular-nums">
                  {g.open && g.close ? `${g.open} - ${g.close}` : copy.contact.closed}
                </dd>
              </div>
            ))
          }
        </dl>
      </article>

      {/* Telefon, e-mail a sítě */}
      <article class="info-card">
        <span class="info-badge" aria-hidden="true">
          <Icon name="ph:phone" class="size-6" />
        </span>
        <h3 class="info-title">{copy.contact.contactTitle}</h3>
        <a
          href={`tel:${site.phone}`}
          class="mt-6 font-display text-[1.5rem] leading-none tabular-nums text-fg transition-colors hover:text-accent-deep"
        >
          {site.phoneDisplay}
        </a>
        <a
          href={`mailto:${site.email}`}
          class="mt-3.5 text-[0.98rem] text-fg-muted transition-colors hover:text-accent-deep"
        >
          {site.email}
        </a>

        <div class="mt-auto flex items-center gap-3 pt-8">
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.footer.instagram}
            class="grid size-11 place-items-center rounded-full border border-line text-fg-muted transition-colors hover:border-accent hover:text-accent-deep"
          >
            <Icon name="ph:instagram-logo" class="size-5" />
          </a>
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.footer.facebook}
            class="grid size-11 place-items-center rounded-full border border-line text-fg-muted transition-colors hover:border-accent hover:text-accent-deep"
          >
            <Icon name="ph:facebook-logo" class="size-5" />
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /*
    Karta. Papír o odstín světlejší než sekce, zlatá vlasová linka místo
    rámečku. Hover mění jen barvy, protože transform karet drží GSAP kvůli
    nabíhání a dva systémy na jedné vlastnosti se vždycky poperou.
  */
  .info-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    padding: 3.75rem 2rem 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--bg) 62%, #fff);
    transition:
      border-color 0.5s var(--ease-silk),
      background-color 0.5s var(--ease-silk);
  }

  .info-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--bg) 42%, #fff);
  }

  /* Prostřední karta drží pohled, stejně jako v předloze od majitelky. */
  .info-card--lead {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--bg) 34%, #fff);
  }

  .info-card--lead:hover {
    border-color: var(--accent);
  }

  /* Zlatý terč sedí na horní hraně a půlkou přesahuje ven. */
  .info-badge {
    position: absolute;
    top: 0;
    left: 2rem;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    transform: translateY(-50%);
    border-radius: 999px;
    background: var(--btn);
    color: var(--btn-fg);
    box-shadow: 0 0 0 6px var(--bg-2);
  }

  .info-title {
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  @media (min-width: 1024px) {
    .info-card {
      padding-inline: 2.25rem;
    }
  }
</style>
