---
/*
  Kontakt — text vlevo, mapa vpravo, obojí v .wrap jako zbytek webu.

  Otevírací doba stojí v rezervaci a v patičce, tady by byla potřetí.
  Údaje o provozovateli patří do patičky, ne sem. Mapa je tmavá deska
  s kartou, která nese odkaz do Google Maps — tlačítko „Otevřít v Mapách“
  vedle ní by bylo totéž podruhé.
*/
import Blend from "./Blend.astro";

const MAPS = "https://maps.app.goo.gl/UFdjuugsRDGuJuGq6";
---

<section class="con" id="kontakt" data-tone="lift">
  <div class="secbg secbg--lift" aria-hidden="true"><img src="/assets/bg/contact.webp" alt="" /></div>

  <div class="wrap con__in">
    <div class="con__copy">
      <h2 class="h2">
        <span class="ml"><span class="ml__i" data-i18n="con.title1">Navštivte nás</span></span>
        <span class="ml"><span class="ml__i"><em data-i18n="con.title2">v srdci Plzně</em></span></span>
      </h2>

      <div class="con__facts">
        <div class="con__fact">
          <span data-i18n="con.address">Adresa</span>
          <b><a href={MAPS} target="_blank" rel="noopener">nám. Republiky 107/14<br />301 00 Plzeň</a></b>
        </div>
        <div class="con__fact">
          <span data-i18n="con.phone">Telefon</span>
          <b><a href="tel:+420778585688">+420 778 585 688</a></b>
        </div>
        <div class="con__fact">
          <span data-i18n="con.mail">E-mail</span>
          <b><a href="mailto:info@meshi-restaurant.cz">info@meshi-restaurant.cz</a></b>
        </div>
      </div>

      <p class="con__social">
        <span data-i18n="con.follow">Sledujte nás</span>
        <a href="https://www.instagram.com/meshi_restaurant.cz/" target="_blank" rel="noopener">
          <svg aria-hidden="true"><use href="#ic-instagram"/></svg><span>Instagram</span>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61578757887900" target="_blank" rel="noopener">
          <svg aria-hidden="true"><use href="#ic-facebook"/></svg><span>Facebook</span>
        </a>
      </p>
    </div>

    <div class="con__map">
      <div class="con__mapFrame">
        <iframe title="Mapa: MESHI Restaurant Plzeň, nám. Republiky 107/14" data-i18n-title="con.mapTitle"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1305.5!2d13.3785312!3d49.7466407!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470af101904b4569%3A0xf3c31f42fa8945cf!2sMeshi%20Restaurant%20Plze%C5%88!5e0!3m2!1scs!2scz"></iframe>
      </div>
      <!-- Na telefonu je vložená mapa pastí na prst: scroll v ní uvázne
           a v 210 px se stejně nikam nedojede. Pod 810 px proto mapa
           nereaguje a celou plochu překrývá tenhle odkaz do Map. -->
      <a class="con__mapTap" href={MAPS} target="_blank" rel="noopener">
        <span data-i18n="con.openMaps">Otevřít v Mapách</span>
        <svg aria-hidden="true"><use href="#ic-arrow"/></svg>
      </a>

      <a class="con__badge" href={MAPS} target="_blank" rel="noopener">
        <span class="con__badgePin" aria-hidden="true"><svg><use href="#ic-pin"/></svg></span>
        <span class="con__badgeCopy">
          <strong>MESHI</strong>
          <span>nám. Republiky 107/14</span>
        </span>
        <span class="con__badgeGo">
          <span data-i18n="con.openMaps">Otevřít v Mapách</span>
          <svg aria-hidden="true"><use href="#ic-arrow"/></svg>
        </span>
      </a>
    </div>
  </div>
  <Blend to="ink" />
</section>
