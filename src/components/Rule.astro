---
/*
  Sumi vlnka pod nadpisem.

  Jediná ozdoba, která se v téhle sekci osvědčila: váže se na nadpis, takže
  má kde začít a kde skončit. Vzor, který pluje volně v prázdné ploše, se
  čte jako nalepený obrázek — viz 13b v global.css.
*/
const { class: cls = "", style = "" } = Astro.props;
---

<span class:list={["sig-rule", cls]} style={style} data-rv="fade-up" aria-hidden="true">
  <svg viewBox="0 0 240 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="1.1">
    <path d="M0 8c6-6 14-6 20 0s14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0 14-6 20 0 14 6 20 0" />
  </svg>
</span>
