---
/*
  Patička — čtyři sloupce a spodní řádek.

  Bez fotky, jen barva, která tmavne ke dnu.
*/
const MAPS = "https://maps.app.goo.gl/UFdjuugsRDGuJuGq6";
---

<footer class="foot">
  <span class="wm wm--foot" aria-hidden="true">飯</span>

  <div class="wrap foot__top">
    <div class="foot__brand">
      <img class="foot__logo" src="/assets/meshi_logo_hero.png?v=gold" width="593" height="421" alt="MESHI" />
      <p class="foot__blurb" data-i18n-html="foot.blurb">
        Autentická asijská kuchyně a prémiové sushi v srdci Plzně. Tradice, poctivé suroviny a filozofie <em>omotenashi</em>.
      </p>
    </div>

    <nav class="fcol" aria-label="Navigace v patičce" data-i18n-aria="foot.navLabel">
      <h5 data-i18n="foot.nav">Navigace</h5>
      <a href="#o-nas" data-i18n="nav.about">O nás</a>
      <a href="#menu" data-i18n="nav.menu">Menu</a>
      <a href="#galerie" data-i18n="nav.gallery">Galerie</a>
      <a href="#rezervace" data-i18n="nav.reserve">Rezervace</a>
      <a href="#poukaz" data-i18n="nav.gift">Dárkový poukaz</a>
      <a href="#kontakt" data-i18n="nav.contact">Kontakt</a>
    </nav>

    <div class="fcol">
      <h5 data-i18n="foot.hours">Otevírací doba</h5>
      <p><span data-i18n="hours.monThu">Po - Čt</span> · 11:00-22:00</p>
      <p><span data-i18n="hours.friSat">Pá - So</span> · 11:00-23:00</p>
      <p><span data-i18n="hours.sun">Neděle</span> · 12:00-22:00</p>
    </div>

    <div class="fcol">
      <h5 data-i18n="foot.find">Kontakt</h5>
      <a href={MAPS} target="_blank" rel="noopener">nám. Republiky 107/14<br />301 00 Plzeň 3-Vnitřní Město</a>
      <a href="tel:+420778585688">+420 778 585 688</a>
      <a href="mailto:info@meshi-restaurant.cz">info@meshi-restaurant.cz</a>
    </div>
  </div>

  <div class="wrap foot__bottom">
    <p>© 2026 MESHI Asian Cuisine · <span data-i18n="foot.rights">Všechna práva vyhrazena</span> · Nguyen Quoc Vinh OSVČ, IČO: 23517034</p>
    <p><a href="#" data-i18n="foot.privacy">Ochrana osobních údajů</a> · <a href="#" data-i18n="foot.terms">Obchodní podmínky</a></p>
  </div>
</footer>
