<section class="section bg-canvas" id="galerie">
  <div class="kanji-bg jp" style="left:-4rem; bottom:-2rem; font-size:26rem" data-drift="55" aria-hidden="true">間</div>

  <div class="wrap">
    <div class="gal-head">
      <div class="section-head">
        <span class="eyebrow" data-rv="fade-right">Galerie</span>
        <h2 data-rv="fade-up">Jak to u nás vypadá</h2>
        <p data-rv="fade-up">
          V útulném prostoru Meshi, plném dřeva a zeleně, chceme našim hostům
          přiblížit autentickou asijskou kuchyni – prostou, poctivou a plnou výrazných chutí.
          Srdcem v každém pokrmu.
        </p>
      </div>
    </div>

    <div class="gal" id="gal">
      <button class="frame gal-print gal-a" type="button" style="--p: 50% 34%"
        aria-label="Hlavní sál restaurace MESHi se závěsnými lampami, zelení a ukiyo-e">
        <img src="/assets/space/interior.webp" alt="" />
      </button>
      <button class="frame gal-print gal-b" type="button" style="--p: 50% 42%"
        aria-label="Prostřený stůl s jídelními lístky MESHi">
        <img src="/assets/space/table.webp" alt="" loading="lazy" />
      </button>
      <button class="frame gal-print gal-c" type="button" style="--p: 36% 78%"
        aria-label="Zátiší s javorem, kočkou maneki-neko a lahví sake">
        <img src="/assets/space/maple.webp" alt="" loading="lazy" />
      </button>
      <button class="frame gal-print gal-d" type="button" style="--p: 50% 52%"
        aria-label="Otevřený vchod s noren závěsem a výhledem na noční náměstí Republiky">
        <img src="/assets/space/door-night.webp" alt="" loading="lazy" />
      </button>
      <button class="frame gal-print gal-e" type="button" style="--p: 42% 68%"
        aria-label="Modrý noren závěs s nápisem MESHi a závěsnou zelení">
        <img src="/assets/space/noren.webp" alt="" loading="lazy" />
      </button>
      <button class="frame gal-print gal-f" type="button" style="--p: 20% 48%"
        aria-label="Stěna s panenkami daruma a dřevěnými tabulkami ema">
        <img src="/assets/space/daruma.webp" alt="" loading="lazy" />
      </button>
      <button class="frame gal-print gal-g" type="button" style="--p: 34% 50%"
        aria-label="Police s lahvemi saké, daruma a výhledem do noci">
        <img src="/assets/space/shelves.webp" alt="" loading="lazy" />
      </button>
    </div>

    <p class="gal-foot">
      <a class="link-u" href="https://www.instagram.com/meshi_restaurant.cz/" target="_blank" rel="noopener">
        Instagram <svg><use href="#ic-ext"/></svg>
      </a>
    </p>
  </div>
</section>
