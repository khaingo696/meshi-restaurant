---
/*
  Galerie — „Výbuch“: sedm fotek se při rolování rozletí z jedné hromádky,
  složí se do koláže kolem nadpisu a při odchodu na místě zhasne.

  Žádný pin: sekce je vysoká jako okno a pohyb jede s jejím průjezdem
  oknem (app.js §9g, scrub). Běžným rolováním je za 2–3 s pryč; kdo chce
  místnost vidět zblízka, vrátí se o kus zpět — koláž se zase složí
  a fotka se dá otevřít v lightboxu. Za letu jsou fotky rozmazané a tmavé,
  složené ostré: oko se samo zastaví tam, kde je na co se dívat.

  Na čem fotka je, tu nehraje roli — pozice určuje jen pořadí v poli
  a třída .gal__ph--N v global.css (sekce 10).
*/

const photos = [
  { slug: "door-night", alt: "gal.d" },
  { slug: "noren",      alt: "gal.e" },
  { slug: "shelves",    alt: "gal.g" },
  { slug: "maple",      alt: "gal.c" },
  { slug: "table",      alt: "gal.b", tall: true },
  { slug: "daruma",     alt: "gal.f" },
  { slug: "interior",   alt: "gal.a" },
];

const file = (p: { slug: string; tall?: boolean }, w: number) => `/assets/space/wide/${p.slug}-${w}.webp`;
const srcset = (p: { slug: string; tall?: boolean }) =>
  (p.tall ? [850, 1280, 1700] : [1280, 1920, 2560]).map((w) => `${file(p, w)} ${w}w`).join(", ");
---

<section class="gal" id="galerie">
  <div class="gal__stage" id="galStage">
    <header class="gal__head">
      <span class="eyebrow eyebrow--gold" data-i18n="gal.eyebrow">Galerie</span>
      <h2 class="h2">
        <span data-i18n="gal.title1">Jak to u nás</span>
        <em data-i18n="gal.title2">vypadá</em>
      </h2>
      <a class="gal__ig" href="https://www.instagram.com/meshi_restaurant.cz/" target="_blank" rel="noopener" data-i18n="gal.ig">
        Další fotky na Instagramu
      </a>
    </header>

    {photos.map((p, i) => (
      <button
        class={`gal__ph gal__ph--${i + 1}`}
        type="button"
        data-full={file(p, p.tall ? 1700 : 2560)}
      >
        <img
          src={file(p, p.tall ? 850 : 1280)}
          srcset={srcset(p)}
          sizes="(min-width: 810px) 34vw, 60vw"
          alt=""
          data-i18n-alt={p.alt}
          width={p.tall ? 1700 : 2560}
          height={p.tall ? 2550 : 1707}
          loading="lazy"
          decoding="async"
        />
      </button>
    ))}
  </div>
</section>
