---
import { Image } from "astro:assets";
import interier from "../assets/interier.jpg";
import ramen from "../assets/ramen.jpg";
import poke from "../assets/poke.jpg";
import Leaves from "./Leaves.astro";
import { alts } from "../data/site";
import { sections, t, type Lang } from "../data/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t[lang];

/*
  Galerie. Text je ze zadání majitelky doslova. Pod ním snímek prostoru a
  vedle něj menší fotky jídla, tak jak zadání popisuje.

  TODO(majitelka): sem přijdou nové fotky, včetně skupinových záběrů více
  pokrmů. Mřížka je stavěná tak, aby snesla šest až osm snímků.
*/
---

<section id={sections.gallery} class="relative overflow-hidden py-(--spacing-section)">
  <Leaves corner="tl" />

  <div class="wrap relative z-10">
    <div class="max-w-[46rem]">
      <h2 data-split class="display-lg text-fg">{copy.gallery.heading}</h2>
      <p data-split="words" class="mt-6 text-[1.04rem] leading-[1.8] text-fg-muted">
        {copy.gallery.body}
      </p>
    </div>

    <div data-frame-group class="mt-14 grid gap-5 md:mt-20 md:grid-cols-12 md:gap-7">
      {/* Prostor restaurace, hlavní snímek */}
      <figure data-frame class="relative aspect-[4/5] overflow-hidden rounded-[var(--radius-card)] md:col-span-7 md:aspect-[4/3]">
        <Image
          data-frame-img
          src={interier}
          alt={alts.interier[lang]}
          widths={[640, 960, 1440]}
          sizes="(min-width: 768px) 58vw, 92vw"
          loading="lazy"
          class="size-full object-cover will-change-transform"
        />
      </figure>

      {/* Jídlo ve dvou menších polích vedle */}
      <div class="grid gap-5 md:col-span-5 md:gap-7">
        <figure data-frame class="relative aspect-[4/3] overflow-hidden rounded-[var(--radius-card)]">
          <Image
            data-frame-img
            src={ramen}
            alt={alts.ramen[lang]}
            widths={[400, 640]}
            sizes="(min-width: 768px) 40vw, 92vw"
            loading="lazy"
            class="size-full object-cover will-change-transform"
          />
        </figure>
        <figure data-frame class="relative aspect-[4/3] overflow-hidden rounded-[var(--radius-card)]">
          <Image
            data-frame-img
            src={poke}
            alt={alts.poke[lang]}
            widths={[400, 640]}
            sizes="(min-width: 768px) 40vw, 92vw"
            loading="lazy"
            class="size-full object-cover will-change-transform"
          />
        </figure>
      </div>
    </div>
  </div>
</section>
