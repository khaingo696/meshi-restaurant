---
/*
  Signatures — ukázka jídel.

  Sekce se připíchne na obrazovku a jídla jedou vodorovně: to uprostřed je
  největší a stojí v ose, ta po stranách se zmenší a nakloní. Fotky jsou
  WebP s alfa kanálem (vyříznuté z pozadí), takže drop-shadow() obkresluje
  skutečný obrys jídla. Kruh, zář a zapuštěné logo tvoří podstavec.

  Tlačítko vpravo dole otevírá <MenuOverlay> s celým lístkem. Kategorii mu
  app.js průběžně přepisuje na tu, ze které je jídlo právě uprostřed, takže
  překryv se otevře v kategorii, kterou si člověk prohlížel.

  Seznam se skládá z src/data/menu.ts — názvy ani ceny se tady nepíšou.
  Vyříznuté fotky existují jen pro část jídel, proto SHOWCASE: slug musí mít
  soubor v public/assets/dishes/. Ceny ještě nejsou (price: null), a dokud
  nebudou, řádek s cenou se nevykreslí — žádné „0 Kč“ ani vymyšlená čísla.
*/
import { categories, formatPrice } from "../data/menu";

/* Pořadí na scéně: nejdřív hlavní jídla, pak předkrmy. Osm jídel je strop:
   délku připíchnuté scény určuje jejich počet, a každé další přidá přes
   500 px rolování. */
const SHOWCASE = [
  "duck-teriyaki",
  "pad-thai",
  "mama-bowl",
  "chicken-katsu-kare",
  "mongolian-beef",
  "ebi-tempura",
  "gyoza",
  "tori-karagge",
];

const dishes = SHOWCASE.map((slug) => {
  const cat = categories.find((c) => c.items.some((d) => d.slug === slug));
  if (!cat) throw new Error(`Signatures: slug "${slug}" není v src/data/menu.ts`);
  const dish = cat.items.find((d) => d.slug === slug)!;
  return {
    cat: cat.slug,
    kicker: cat.label,
    name: dish.name,
    price: formatPrice(dish.price) ?? "",
    img: `/assets/dishes/${slug}.webp`,
  };
});

const first = dishes[0];
---

<section class="show" id="menu">
  <div class="wrap show__head">
    <span class="kanji" aria-hidden="true">匠</span>
    <span class="eyebrow eyebrow--gold" data-i18n="sig.title">Naše signatures</span>
    <h2 class="h2">
      <span class="ml"><span class="ml__i" data-i18n="sig.sub1">Harmonie poctivé chuti</span></span>
      <span class="ml"><span class="ml__i"><em data-i18n="sig.sub2">v každém soustu</em></span></span>
    </h2>
  </div>

  <div class="show__pin" id="showPin">
    <div class="show__ring" aria-hidden="true"></div>
    <div class="show__glow" aria-hidden="true"></div>
    <img class="show__mark" id="showMark" src="/assets/meshi_logo_hero.png?v=gold" alt="" aria-hidden="true" />

    <div class="show__stage" id="showStage">
      {dishes.map((d) => (
        <figure class="dish" data-cat={d.cat} data-kicker={d.kicker} data-name={d.name} data-price={d.price}>
          <img src={d.img} alt={d.name} width="900" height="900" loading="lazy" decoding="async" />
          <!-- Popisek je vidět jen v náhradní podobě scény (bez pohybu nebo
               bez GSAP), kde se pás roluje prstem. Jinak jméno nese
               .show__meta uprostřed. -->
          <figcaption class="dish__cap">
            <span class="dish__kicker" data-i18n={`cat.${d.cat}`}>{d.kicker}</span>
            <span class="dish__name">{d.name}</span>
            {d.price && <span class="dish__price">{d.price}</span>}
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Název jídla uprostřed. Pro čtečky je to duplikát — jméno každého
         jídla už nese alt jeho fotky, a hlásit deset změn za jedno
         rolování by bylo na obtíž. Proto aria-hidden. -->
    <div class="show__meta" aria-hidden="true">
      <span class="show__kicker" id="showKicker">{first.kicker}</span>
      <span class="show__name" id="showName">{first.name}</span>
      <span class="show__price" id="showPrice">{first.price}</span>
    </div>

    <div class="show__bar" aria-hidden="true"><i id="showBar"></i></div>

    <button class="show__cta btn btn--line" id="showMenuBtn" type="button"
            data-cat={first.cat} aria-haspopup="dialog" aria-expanded="false">
      <span data-i18n="sig.full">Zobrazit celé menu</span> <span class="btn__arrow" aria-hidden="true">→</span>
    </button>
  </div>
</section>
