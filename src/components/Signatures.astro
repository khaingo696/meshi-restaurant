---
/*
  Signatures — ukázka jídel.

  Den po soumraku O nás. Podkladem je holý papír washi (washi-day.webp,
  viz scripts/build-day-bg.mjs) — malba za talířem by jídlu brala oko,
  jídlo je tu jediná kresba. S O nás ji nespojuje přechod barvy, ale
  MATERIÁL: list washi s ručně utrženou horní hranou (.show__tear,
  tear-edge.webp) leží přes papír O nás. Dvě různé barvy papíru vedle
  sebe tak nejsou šev, který musí splynout — jsou to dva listy na sobě.

  Konec pinu je zhasnutí v kině (.show__dusk, app.js): po posledním jídle
  se tma stáhne od krajů okna k talíři jako clona a nechá ho v kuželu
  světla. Jméno jídla a tlačítko menu přejdou do nočního materiálu, takže
  poslední záběr není prázdný. Galerie pak začíná ve tmě, bez švu.

  Sekce se připíchne na obrazovku a jídla jedou vodorovně: to uprostřed je
  největší a stojí v ose, ta po stranách se zmenší a nakloní. Fotky jsou
  WebP s alfa kanálem (vyříznuté z pozadí), takže drop-shadow() obkresluje
  skutečný obrys jídla. Kruh, zář a zapuštěné logo tvoří podstavec.
  Pod každým talířem leží vržený stín (.dish__shadow): světlo stojí nad
  středem scény, takže talíř uprostřed má stín krátký a hutný, talíř
  odjíždějící do strany dlouhý a slabý, odvrácený od středu.

  Tlačítko pod názvem jídla otevírá <MenuOverlay> s celým lístkem. Kategorii mu
  app.js průběžně přepisuje na tu, ze které je jídlo právě uprostřed, takže
  překryv se otevře v kategorii, kterou si člověk prohlížel.

  Seznam se skládá z src/data/menu.ts — názvy ani ceny se tady nepíšou.
  Vyříznuté fotky existují jen pro část jídel, proto SHOWCASE: slug musí mít
  soubor v public/assets/dishes/. Ceny ještě nejsou (price: null), a dokud
  nebudou, řádek s cenou se nevykreslí — žádné „0 Kč“ ani vymyšlená čísla.
*/
import { categories, formatPrice } from "../data/menu";
import Blend from "./Blend.astro";

/* Pořadí na scéně: hlavní jídla, předkrmy, sushi. Osm jídel je strop:
   délku připíchnuté scény určuje jejich počet, a každé další přidá přes
   500 px rolování. Jen cutouty, kde je talíř celý a alfa obkresluje
   skutečný obrys — oříznuté scény (rýže uříznutá rámem, deska jako
   obdélník) sem nepatří. */
const SHOWCASE = [
  "duck-teriyaki",
  "chahan",
  "bossam",
  "ebi-tempura",
  "soft-shell-crab",
  "nigiri",
  "samuraj-roll",
  "geisha-tempura-roll",
];

const dishes = SHOWCASE.map((slug) => {
  const cat = categories.find((c) => c.items.some((d) => d.slug === slug));
  if (!cat) throw new Error(`Signatures: slug "${slug}" není v src/data/menu.ts`);
  const dish = cat.items.find((d) => d.slug === slug)!;
  return {
    cat: cat.slug,
    kicker: cat.label,
    name: dish.name,
    price: formatPrice(dish.price) ?? "",
    img: `/assets/dishes/${slug}.webp`,
  };
});

const first = dishes[0];
---

<section class="show" id="menu" data-tone="day">
  <!-- Utržená hrana listu, přesahuje nahoru přes O nás. Mimo pin: v pinu
       by zůstala přilepená k horní hraně okna po celou scénu. -->
  <div class="show__tear" aria-hidden="true"></div>

  <div class="show__pin" id="showPin">
    <!-- Podklad je UVNITŘ pinu a stojí: kdyby pin byl průhledný, papír
         sekce by pod ním při rolování ujížděl. -->
    <div class="secbg secbg--day show__bg" aria-hidden="true"><img src="/assets/bg/washi-day.webp" alt="" /></div>
    <!-- Zhasnutí: clona tmy kolem talíře. Poloměry a střed řídí app.js. -->
    <div class="show__dusk" id="showDusk" aria-hidden="true"><i></i></div>

    <!-- Nadpis patří DO pinu: jinak na telefonu zmizí, jakmile se scéna
         připíchne, a od talíře ho dělí celá výška okna. -->
    <div class="wrap show__head">
      <h2 class="h2">
        <span class="ml"><span class="ml__i" data-i18n="sig.title1">Naše</span></span>
        <span class="ml"><span class="ml__i"><em data-i18n="sig.title2">signatures</em></span></span>
      </h2>
    </div>

    <!-- Talíř, kruh a logo sdílejí jednu studnu: na telefonu se pak
         nemůžou rozjet — dřív byl kruh na 40 % pinu a jídlo na 50 %. -->
    <div class="show__well">
      <div class="show__ring" aria-hidden="true"></div>
      <div class="show__glow" aria-hidden="true"></div>
      <img class="show__mark" id="showMark" src="/assets/meshi_logo_hero.png?v=gold" alt="" aria-hidden="true" />

      <div class="show__stage" id="showStage">
      {dishes.map((d) => (
        <figure class="dish" data-cat={d.cat} data-kicker={d.kicker} data-name={d.name} data-price={d.price}>
          <span class="dish__shadow" aria-hidden="true"></span>
          <img src={d.img} alt={d.name} width="900" height="900" loading="lazy" decoding="async" />
          <!-- Popisek je vidět jen v náhradní podobě scény (bez pohybu nebo
               bez GSAP), kde se pás roluje prstem. Jinak jméno nese
               .show__meta uprostřed. -->
          <figcaption class="dish__cap">
            <span class="dish__kicker" data-i18n={`cat.${d.cat}`}>{d.kicker}</span>
            <span class="dish__name">{d.name}</span>
            {d.price && <span class="dish__price">{d.price}</span>}
          </figcaption>
        </figure>
      ))}
      </div>
    </div>

    <!-- Název jídla uprostřed. Pro čtečky je to duplikát — jméno každého
         jídla už nese alt jeho fotky, a hlásit deset změn za jedno
         rolování by bylo na obtíž. Proto aria-hidden. -->
    <div class="show__meta" aria-hidden="true">
      <span class="show__kicker" id="showKicker">{first.kicker}</span>
      <span class="show__name" id="showName">{first.name}</span>
      <span class="show__price" id="showPrice">{first.price}</span>
    </div>

    <div class="show__bar" aria-hidden="true"><i id="showBar"></i></div>

    <button class="show__cta btn btn--act" id="showMenuBtn" type="button"
            data-cat={first.cat} aria-haspopup="dialog" aria-expanded="false">
      <span data-i18n="sig.full">Zobrazit celé menu</span>
      <span class="btn__arrow" aria-hidden="true"><svg><use href="#ic-arrow"/></svg></span>
    </button>
  </div>
  <Blend to="ink" />
</section>
