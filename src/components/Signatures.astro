---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import ramen from "../assets/ramen.jpg";
import poke from "../assets/poke.jpg";
import { alts, site } from "../data/site";
import { sections, t, type Lang } from "../data/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t[lang];

/*
  Naše signatures. Skladba přesně podle zadání: vlevo úvod, vpravo seznam,
  pod seznamem odkaz na celé menu v PDF, a teprve pod tím fotky pokrmů.

  TODO(majitelka): fotky pro tempuru a takoyaki. Zatím mají rám s kandži.
  Cizí stock sem nedáváme, sliboval by jídlo, které takhle neservírujete.
*/
const photos = [
  { ...copy.signatures.items[0], image: poke, alt: alts.poke[lang] },
  { ...copy.signatures.items[1], image: ramen, alt: alts.ramen[lang] },
  { ...copy.signatures.items[2], image: null, alt: null },
  { ...copy.signatures.items[3], image: null, alt: null },
];
---

<section id={sections.menu} class="relative overflow-hidden bg-bg-2 py-(--spacing-section)">
  <div class="wrap relative z-10">

    <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
      {/* Vlevo úvod */}
      <div class="lg:col-span-5">
        <h2 data-split class="display-lg text-fg">{copy.signatures.heading}</h2>
        <p data-split="words" class="mt-6 max-w-[40ch] text-[1.02rem] leading-[1.75] text-fg-muted">
          {copy.signatures.lead}
        </p>
      </div>

      {/* Vpravo seznam, pod ním odkaz na PDF */}
      <div class="lg:col-span-6 lg:col-start-7">
        <ul data-stagger class="divide-y divide-line border-t border-line">
          {
            copy.signatures.items.map((it) => (
              <li class="flex items-baseline gap-5 py-5">
                <span class="kana w-[5.6rem] shrink-0 text-[1.05rem] text-accent-deep">{it.jp}</span>
                <span class="font-display text-[1.6rem] leading-none text-fg">{it.name}</span>
                <span class="ml-auto max-w-[22ch] text-right text-[0.9rem] leading-snug text-fg-muted">
                  {it.desc}
                </span>
              </li>
            ))
          }
        </ul>

        <a
          href={site.menuPdf}
          class="group mt-8 inline-flex items-center gap-2.5 border-b border-line-strong pb-1 text-[0.78rem] tracking-[0.14em] uppercase text-fg transition-colors hover:border-accent hover:text-accent-deep"
        >
          <Icon name="ph:file-pdf" class="size-4" />
          {copy.signatures.cta}
          <Icon
            name="ph:arrow-up-right"
            class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>
    </div>

    {/* Pod odkazem fotky pokrmů, prostřídané do výšky */}
    <div data-frame-group class="mt-16 grid grid-cols-2 gap-5 md:mt-24 md:grid-cols-4 md:gap-7">
      {
        photos.map((d, i) => (
          <figure class:list={["min-w-0", i % 2 === 1 && "md:mt-12"]}>
            <div data-frame class="relative aspect-[4/5] overflow-hidden rounded-[var(--radius-card)] bg-bg">
              {d.image && d.alt ? (
                <Image
                  data-frame-img
                  src={d.image}
                  alt={d.alt}
                  widths={[320, 480, 720]}
                  sizes="(min-width: 768px) 22vw, 46vw"
                  loading="lazy"
                  class="size-full object-cover will-change-transform"
                />
              ) : (
                <div class="grid size-full place-items-center rounded-[var(--radius-card)] border border-line">
                  <span class="kana text-[3rem] leading-none text-accent/35" aria-hidden="true">
                    {d.jp}
                  </span>
                </div>
              )}
            </div>
            <figcaption class="mt-3 flex items-baseline gap-2">
              <span class="font-display text-[1.15rem] leading-none text-fg">{d.name}</span>
              <span class="kana text-[0.8rem] text-accent-deep" aria-hidden="true">{d.jp}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
