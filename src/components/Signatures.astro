---
/*
  Signatures — nadpis, odstavec a tři karty kategorií.

  Japonský rejstřík, ale měkký: pečeť hanko přes roh fotky, sumi vlnka pod
  nadpisem, washi vlákno pod celou sekcí. Motivy ano, ostré hrany ne.

  Karty jsou stejně velké a jen posazené do různé výšky — tři kategorie jsou
  si rovny, žádná nesmí vypadat důležitěji než ostatní. Štítek s názvem
  přesahuje přes spodní hranu fotky, stejné vrstvení jako v sekci O nás.

  Kliknutí otevře překryv <MenuOverlay>, obsluhu dělá app.js.
*/
import { categories } from "../data/menu";
import Rule from "./Rule.astro";
---

<section class="section bg-sand paper" id="signatures">
  <div class="kanji-bg jp" style="left:-2rem; top:4rem; font-size:26rem" data-drift="-60" aria-hidden="true">匠</div>
  <div class="kanji-bg jp" style="right:-1rem; bottom:4rem; font-size:20rem; opacity:.03" data-drift="50" aria-hidden="true">味</div>
  <div class="glow" style="width:28rem;height:28rem;top:18%;left:28%;background:rgba(200,150,80,.14)"></div>
  <div class="glow" style="width:30rem;height:30rem;bottom:6%;right:14%;background:rgba(124,74,45,.1)"></div>

  <div class="wrap">
    <div class="sig-head">
      <div class="section-head">
        <h2 data-rv="fade-up"><span data-i18n="sig.title">Naše signatures</span>
          <span class="sub" data-rv="fade-up" data-i18n="sig.sub">Harmonie poctivé chuti v každém soustu</span>
        </h2>
        <p data-rv="fade-up" data-i18n="sig.body">
          Pečlivě vybíráme kvalitní suroviny a každý den používáme čerstvé potraviny.
          Každému pokrmu věnujeme čas, péči a srdce, protože věříme, že právě na kvalitě surovin a poctivé přípravě záleží.
          V MESHi můžete ochutnat výrazné a poctivé asijské polévky, naše speciální předkrmy, charakteristický ramen,
          tradiční sushi s domácí sójovou omáčkou i oblíbená asijská jídla, která možná už dlouho hledáte.
        </p>
      </div>
      <div class="sig-actions" data-rv="fade-up">
        <a class="btn btn-primary" href="/docs/menu.pdf" target="_blank" rel="noopener"><svg><use href="#ic-menu-book"/></svg><span data-i18n="sig.full">Zobrazit celé menu</span><svg><use href="#ic-arrow"/></svg></a>
      </div>
    </div>

    <Rule />

    <div class="cats">
      {categories.map((cat, i) => (
        <button
          class="cat"
          type="button"
          data-cat={cat.slug}
          data-n={cat.items.length}
          data-rv="rise"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <span class="cat-seal" aria-hidden="true"><b>{String(i + 1).padStart(2, "0")}</b></span>

          <span class="cat-shot">
            <img
              src={cat.cover}
              srcset={`${cat.cover} 900w, ${cat.cover.replace(".webp", "@2x.webp")} 1800w`}
              sizes="(max-width: 700px) 92vw, (max-width: 1100px) 44vw, 360px"
              alt={cat.coverAlt}
              data-i18n-alt={`cat.${cat.slug}Alt`}
              width="900"
              height="1125"
              loading="lazy"
              decoding="async"
            />
          </span>

          <span class="cat-plate">
            <span class="cat-plate-txt">
              <span class="cat-name" data-i18n={`cat.${cat.slug}`}>{cat.label}</span>
            </span>
            <span class="cat-arr" aria-hidden="true"><svg><use href="#ic-arrow"/></svg></span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>
