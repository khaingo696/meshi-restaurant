---
import { getImage } from "astro:assets";
import leaf1 from "../assets/leaf-1-cut.png";
import leaf2 from "../assets/leaf-2-cut.png";

/*
  Padající javorové listy.

  Listy jsou vyříznuté z prostírání restaurace a mají skutečnou průhlednost:
  alfa je dopočítaná z rozdílu jasu proti papíru (226 papír, 180 nejtmavší
  místo listu) a zrno papíru je pod prahem odříznuté. Dřív to byly jen
  obdélníkové výřezy schované přes `mix-blend-mode`, což se prozradilo
  všude, kde list přeletěl přes logo nebo tlačítko.

  Filmová hloubka stojí na třech plánech. Blízké listy jsou velké, rozostřené
  a letí rychle napříč celým polem; vzdálené jsou drobné, bledé a sotva se
  hnou. Oko z toho složí prostor.

  Dráha vzniká vrstvením tří animací s různou délkou:
    vnější   pád a příčný let
    střední  boční houpání
    vnitřní  přemet ve třech osách
  Protože se jejich periody nekryjí, cesta se nikdy přesně neopakuje.

  Dělá to CSS, ne GSAP: nekonečná smyčka na pozadí nemá zatěžovat ticker,
  který obsluhuje scroll.
*/
const a = (await getImage({ src: leaf1, width: 160, format: "webp" })).src;
const b = (await getImage({ src: leaf2, width: 160, format: "webp" })).src;

type Leaf = {
  src: string;
  /** plán: 1 daleko, 2 střed, 3 blízko */
  z: 1 | 2 | 3;
  /** startovní pozice a příčný let ve vw */
  sx: number;
  dx: number;
  size: number;
  dur: number;
  delay: number;
  sway: number;
  rx: number;
  ry: number;
  rz: number;
};

const leaves: Leaf[] = [
  // Pět listů. Jeden vzdálený, tři střední, jeden blízký, aby scéna měla
  // hloubku i při malém počtu.
  { src: a, z: 1, sx: 14, dx: 15, size: 22, dur: 50, delay: 0, sway: 1.2, rx: 130, ry: 280, rz: 95 },
  { src: b, z: 2, sx: 33, dx: -30, size: 34, dur: 34, delay: 11, sway: 2.9, rx: -180, ry: -360, rz: -140 },
  { src: a, z: 2, sx: 58, dx: 40, size: 30, dur: 29, delay: 23, sway: 2.5, rx: 210, ry: 330, rz: 175 },
  { src: b, z: 2, sx: 86, dx: -26, size: 37, dur: 37, delay: 6, sway: 3.2, rx: -195, ry: 390, rz: -125 },
  { src: a, z: 3, sx: -10, dx: 120, size: 52, dur: 19, delay: 15, sway: 4.2, rx: 300, ry: 600, rz: 250 },
];
---

<div class="leaf-field" aria-hidden="true">
  {
    leaves.map((l) => (
      <span
        class:list={["fall", `z${l.z}`]}
        style={`--sx:${l.sx}vw; --dx:${l.dx}vw; --s:${l.size}px; --d:${l.dur}s; --z:-${l.delay}s; --sway:${l.sway}vw; --rx:${l.rx}deg; --ry:${l.ry}deg; --rz:${l.rz}deg`}
      >
        <span class="sway">
          <span class="tumble">
            <img src={l.src} alt="" width="160" height="160" loading="lazy" decoding="async" />
          </span>
        </span>
      </span>
    ))
  }
</div>

<style>
  .leaf-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /*
      Nejvyšší vrstva v hero, hned pod fixní navigací (z-index 30). Listy tak
      přeletí přes logo i tlačítka. Ověřeno: list položený na logo přepíše
      4664 pixelů, takže se opravdu kreslí navrch.

      `pointer-events: none` drží kliknutí průchozí, tlačítka pod listem
      dál fungují.
    */
    z-index: 25;
  }

  .fall {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: var(--s);
    animation: fall var(--d) linear var(--z) infinite;
    will-change: transform;
  }

  .sway {
    display: block;
    /* Jiná perioda než pád, proto se dráha nikdy nezopakuje stejně. */
    animation: sway calc(var(--d) / 2.7) ease-in-out infinite alternate;
  }

  .tumble {
    display: block;
    animation: tumble calc(var(--d) / 1.6) linear infinite;
    transform-style: preserve-3d;
  }

  .fall img {
    display: block;
    width: 100%;
    height: auto;
    /*
      Žádné míchání. List má teď skutečnou alfu a vlastní hnědý tón, takže
      se kreslí přímo. Přes `multiply` byl sotva znát, protože násobení dvou
      blízkých krémových tónů posune jas jen o pár stupňů.
    */
  }

  /* Tři plány: velikost sama nestačí, hloubku dělá až rozostření a bledost. */
  /*
    Krytí 0.4, žádné rozostření, tón #b09571.

    Stejný tón i krytí mají větve v rozích, aby všechny listy působily jako
    jedna vrstva papíru. Kdyby se tóny lišily, znamenalo by stejné krytí
    u každé skupiny něco jiného.

    Poznámka k ladění: v tomhle bledém pásmu už měření kontrastu nedává
    spolehlivé číslo. Jeden tón vyšel při třech měřeních 93, 56 a 29,
    protože pokaždé je na obrazovce jiná sestava listů a průměr se počítá
    jen z pixelů nad prahem. Ladí se proto okem, ne podle čísla.

    Blízké listy měly filter: blur(4px) jako náznak hloubky ostrosti. Jenže
    rozmazat poloprůhledný tvar na málo kontrastním papíře nedá dojem
    blízkosti, dá šmouhu. Hloubku nese velikost a rychlost: blízké listy jsou
    78 až 110 px a přeletí pole za 15 až 21 s, vzdálené mají 15 až 20 px
    a padají 44 až 55 s. To oko čte samo.
  */
  .fall img {
    opacity: 0.4;
  }

  @keyframes fall {
    from {
      transform: translate3d(var(--sx), -22vh, 0);
    }
    to {
      transform: translate3d(calc(var(--sx) + var(--dx)), 118vh, 0);
    }
  }

  @keyframes sway {
    from {
      transform: translateX(calc(var(--sway) * -1));
    }
    to {
      transform: translateX(var(--sway));
    }
  }

  /*
    Osa je z větší části Z, tedy otáčení v rovině obrazovky. Když převažovalo
    Y, list se většinu času stavěl hranou k divákovi a vypadal jako tenká
    tříska. Malý podíl X a Y stačí, aby se občas naklonil a nepůsobil placatě.
  */
  @keyframes tumble {
    from {
      transform: rotate3d(0.2, 0.3, 1, 0deg);
    }
    to {
      transform: rotate3d(0.2, 0.3, 1, var(--ry));
    }
  }

  /* Na úzkých displejích jen střední plán: blízké listy by přes text přeletěly
     příliš blízko a drobné by zanikly. */
  @media (width < 48rem) {
    .z1,
    .z3 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf-field {
      display: none;
    }
  }
</style>
