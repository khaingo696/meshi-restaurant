<section class="section bg-surface" id="rezervace">
  <div class="kanji-bg jp" style="left:-3rem; bottom:-1rem; font-size:22rem" data-drift="-50" aria-hidden="true">席</div>
  <div class="glow" style="width:28rem;height:28rem;top:18%;left:50%;translate:-50% 0;background:rgba(200,150,80,.12)"></div>

  <div class="wrap">
    <div class="res-card" data-rv="fade-up">
      <div class="res-top">
        <span class="eyebrow center">Rezervovat stůl</span>
        <h2>Rezervujte si svůj stůl</h2>
        <p class="small">Potvrzení posíláme do 15 minut. Raději telefonicky?</p>
        <a class="res-phone" href="tel:+420778585688"><svg><use href="#ic-phone"/></svg>+420 778 585 688</a>
      </div>

      <form class="stack" id="resForm" novalidate>
        <div class="fgrid">
          <div class="field"><label for="r-name">Jméno a příjmení *</label><input id="r-name" type="text" placeholder="Jan Novák" required /></div>
          <div class="field"><label for="r-phone">Telefon *</label><input id="r-phone" type="tel" placeholder="+420 777 000 000" required /></div>
          <div class="field"><label for="r-mail">E-mail *</label><input id="r-mail" type="email" placeholder="jan.novak@email.cz" required /></div>
          <div class="field"><label for="r-date">Datum *</label><input id="r-date" type="date" required /></div>
          <div class="field"><label for="r-time">Čas *</label>
            <select id="r-time" required>
              <option>17:00</option><option>17:30</option><option selected>18:00</option><option>18:30</option>
              <option>19:00</option><option>19:30</option><option>20:00</option><option>20:30</option>
            </select>
          </div>
          <div class="field"><label for="r-ppl">Počet osob *</label>
            <select id="r-ppl" required>
              <option>1 osoba</option><option selected>2 osoby</option><option>3 osoby</option><option>4 osoby</option>
              <option>5 osob</option><option>6 osob</option><option>7 osob</option><option>8 osob</option>
            </select>
          </div>
        </div>

        <button class="note-toggle" type="button" id="noteToggle" aria-expanded="false" aria-controls="noteField">
          <span class="plus" aria-hidden="true"></span>Přidat poznámku <span class="opt">(alergie, dětská židlička, oslava)</span>
        </button>
        <div class="field" id="noteField" hidden>
          <label for="r-note" class="sr-only">Poznámka</label>
          <textarea id="r-note" rows="2" placeholder="Vaše přání nebo dietní preference…"></textarea>
        </div>

        <div class="consent">
          <input id="r-gdpr" type="checkbox" required />
          <label for="r-gdpr">Souhlasím se zpracováním údajů pro vyřízení rezervace. <a href="#">Zásady ochrany osobních údajů</a>. U skupin nad 8 osob volejte prosím telefonicky.</label>
        </div>

        <div class="res-cta">
          <button class="btn btn-primary" type="submit">Odeslat rezervaci</button>
        </div>

        <p class="ok-box" id="resOk" role="status">Děkujeme! Vaši rezervaci jsme přijali a potvrzení vám zašleme do 15 minut.</p>
      </form>
    </div>
  </div>
</section>
