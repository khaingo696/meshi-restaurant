---
/*
  Panel s navigací — hlavní nabídka webu, otevírá ji tlačítko Menu v liště.

  V mockupu je lišta prázdná a všechno se otevírá odsud, takže tady musí být
  i to, co dřív viselo v liště: telefon a online objednávka.

  Podoba a pohyb sedí v global.css, sekci 16: panel se zavírá jako šódži,
  dvě křídla přijedou ze stran a text jede s nimi. Šipka u odkazu odešla —
  aktivní sekci značí svislý paprsek u levé hrany řádku a řádek pod rukou
  se doostří. Plnou výšku řádku si odkazy nechávají, aby se trefovaly
  palcem.
*/
const links = [
  { href: "#top", key: "nav.home", label: "Domů" },
  { href: "#o-nas", key: "nav.about", label: "O nás" },
  { href: "#menu", key: "nav.menu", label: "Menu" },
  { href: "#galerie", key: "nav.gallery", label: "Galerie" },
  { href: "#rezervace", key: "nav.reserve", label: "Rezervace" },
  { href: "#poukaz", key: "nav.gift", label: "Dárkový poukaz" },
  { href: "#kontakt", key: "nav.contact", label: "Kontakt" },
];
---

<div class="sheet" id="sheet">
  <nav class="sheet-nav" aria-label="Hlavní nabídka" data-i18n-aria="nav.main">
    {links.map((l) => (
      <a href={l.href}><span data-i18n={l.key}>{l.label}</span></a>
    ))}
  </nav>

  <!-- Rezervace tu není schválně — sedí v liště, kde je vidět pořád, a
       dvakrát na jedné obrazovce nemá co dělat.

       Zbylé dvě akce jsou holý text (global.css, sekce 4, stupeň 2), takže
       je vedle sebe drží prázdno; mřížka na půl dávala smysl, dokud to byly
       rámečky. Přepínač jazyka má vlastní řádek nad nimi: je to stav, ne
       akce. -->
  <div class="sheet-foot">
    <div class="lang" role="group" aria-label="Jazyk" data-i18n-aria="nav.lang">
      <button type="button" class="on" data-lang="cs" aria-pressed="true">CZ</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <a class="btn btn--line" href="tel:+420778585688"><svg><use href="#ic-phone"/></svg><span data-i18n="nav.call">Zavolat</span></a>
    <!-- PŘEDÁVKA: tlačítko zatím nemá obsluhu — chybí odkaz na rozvozovou
         platformu nebo vlastní objednávkový tok. -->
    <button class="btn btn--ghost btn-order" id="objednavka" type="button" data-i18n="nav.order">Online objednávka</button>
  </div>
</div>
