---
/*
  Domovská stránka.

  Plochy se střídají noc a den: hero (noc, ink) → O nás (soumrak,
  wash.webp) → signatures (DEN, washi-day.webp; na konci pinu soumrak) →
  galerie (noc) → rezervace (DEN, shoji-pine.webp) → poukaz (zlato,
  paper-plum) → kontakt (contact.webp) → patička (ink).
  Mezi tmou a světlem nestačí alfa — šev jde přes jantar v OKLCH (global.css,
  sekce 7). Na telefonu rezervace a poukaz zůstanou jeden pult.
*/
import Base from "../layouts/Base.astro";
import Icons from "../components/Icons.astro";
import Header from "../components/Header.astro";
import Sheet from "../components/Sheet.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Signatures from "../components/Signatures.astro";
import Gallery from "../components/Gallery.astro";
import Reserve from "../components/Reserve.astro";
import Voucher from "../components/Voucher.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import ToTop from "../components/ToTop.astro";
import Lightbox from "../components/Lightbox.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
---

<Base door>
  <Icons />
  <Header />
  <Sheet />

  <main id="top">
    <Hero />
    <About />
    <Signatures />
    <Gallery />
    <Reserve />
    <Voucher />
    <Contact />
  </main>

  <Footer />
  <ToTop />
  <MenuOverlay />
  <Lightbox />
</Base>
