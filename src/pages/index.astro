---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Signatures from "../components/Signatures.astro";
import Gallery from "../components/Gallery.astro";
import Voucher from "../components/Voucher.astro";
import Reserve from "../components/Reserve.astro";
import Contact from "../components/Contact.astro";

/*
  Pořadí sekcí přesně podle zadání majitelky:
  Domů, Menu (Naše signatures), Galerie, Rezervace, Dárkový poukaz, Kontakt.
  Sekce O nás na přání majitelky odpadla.
*/
const lang = "cs" as const;
---

<Base lang={lang}>
  <Hero lang={lang} />
  <Signatures lang={lang} />
  <Gallery lang={lang} />
  <Reserve lang={lang} />
  <Voucher lang={lang} />
  <Contact lang={lang} />
</Base>
