---
/*
  Domovská stránka.

  Pořadí sekcí drží střídání ploch: tmavá (hero) → podmalba (O nás) →
  připíchnutá ukázka jídel → připíchnutá galerie → tmavá (rezervace) →
  jediná světlá (poukaz) → tmavá (kontakt, patička).
  Dvě světlé plochy vedle sebe by přechod rozbily.
*/
import Base from "../layouts/Base.astro";
import Icons from "../components/Icons.astro";
import Header from "../components/Header.astro";
import Sheet from "../components/Sheet.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Signatures from "../components/Signatures.astro";
import Gallery from "../components/Gallery.astro";
import Reserve from "../components/Reserve.astro";
import Voucher from "../components/Voucher.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import ToTop from "../components/ToTop.astro";
import Lightbox from "../components/Lightbox.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
---

<Base door>
  <Icons />
  <Header />
  <Sheet />

  <main id="top">
    <Hero />
    <About />
    <Signatures />
    <Gallery />
    <Reserve />
    <Voucher />
    <Contact />
  </main>

  <Footer />
  <ToTop />
  <MenuOverlay />
  <Lightbox />
</Base>
