---
/*
  Domovská stránka.

  Marquee je mezi O nás a Signatures, protože tam dělá dělicí pás mezi
  dvěma světlými plochami.
*/
import Base from "../layouts/Base.astro";
import Icons from "../components/Icons.astro";
import Header from "../components/Header.astro";
import Sheet from "../components/Sheet.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Marquee from "../components/Marquee.astro";
import Signatures from "../components/Signatures.astro";
import Reviews from "../components/Reviews.astro";
import Gallery from "../components/Gallery.astro";
import Reserve from "../components/Reserve.astro";
import Voucher from "../components/Voucher.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
---

<Base>
  <Icons />
  <Header />
  <Sheet />

  <main id="top">
    <Hero />
    <About />
    <Marquee />
    <Signatures />
    <Reviews />
    <Gallery />
    <Reserve />
    <Voucher />
    <Contact />
  </main>

  <Footer />
  <Lightbox />
</Base>
