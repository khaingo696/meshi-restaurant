# Cloudflare Pages servíruje všechno s max-age=0, takže se při každé návštěvě
# revaliduje i to, co se nikdy nemění. Hashované a verzované soubory můžou
# ležet v cache rok; fotky v /assets jen týden, aby se dala vyměnit fotka
# beze změny názvu.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/docs/*
  Cache-Control: public, max-age=604800

# Hodnocení se přepisuje skriptem, ať se chytí nové číslo do pěti minut.
/google-rating.json
  Cache-Control: public, max-age=300

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
